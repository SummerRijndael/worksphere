{
    "name": "worksphere/chat",
    "description": "A decoupled real-time chat package for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ryan",
            "email": "ryan@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/broadcasting": "^11.0|^12.0",
        "pusher/pusher-php-server": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "WorkSphere\\Chat\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WorkSphere\\Chat\\Providers\\ChatServiceProvider"
            ]
        }
    }
}
