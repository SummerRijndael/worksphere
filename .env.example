# ===========================================
# WorkSphere - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit your .env file to version control!
# ===========================================

# -------------------------------------------
# Application Settings
# -------------------------------------------
APP_NAME=WorkSphere
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000
APP_FRONTEND_URL="${APP_URL}"
FRONTEND_URL="${APP_URL}"

APP_DEMO_MODE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -------------------------------------------
# Logging
# -------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------
# Database
# -------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=worksphere
DB_USERNAME=root
DB_PASSWORD=

# -------------------------------------------
# Session
# -------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# -------------------------------------------
# Cache & Queue
# -------------------------------------------
CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=redis
FILESYSTEM_DISK=private
DISABLE_RATE_LIMITS=false

# -------------------------------------------
# Redis (Optional - for production)
# -------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# -------------------------------------------
# Broadcasting (Laravel Reverb)
# -------------------------------------------
# Required for real-time features: chat, notifications, presence
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=worksphere-app
REVERB_APP_KEY=worksphere-key
REVERB_APP_SECRET=worksphere-secret
REVERB_HOST="localhost"
REVERB_PORT=9000
REVERB_SCHEME=http
REVERB_ALLOW_CLIENT_MESSAGES=true

# Frontend (Vite) - automatically uses REVERB values
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -------------------------------------------
# Mail
# -------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=null
MAIL_SCHEME=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------
# OAuth - Google
# -------------------------------------------
# For social login and calendar sync
# Enable Google Calendar API in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/callback/calendar"
GOOGLE_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=

# -------------------------------------------
# OAuth - GitHub
# -------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

# -------------------------------------------
# Auth Feature Toggles
# -------------------------------------------
AUTH_REGISTRATION_ENABLED=true
AUTH_EMAIL_VERIFICATION=true
AUTH_SOCIAL_LOGIN_ENABLED=true
# Enables popup-based social login transport on the login page.
# Set to false to force legacy full-page redirect flow.
AUTH_SOCIAL_LOGIN_POPUP_ENABLED=true

# -------------------------------------------
# reCAPTCHA (Bot Protection)
# -------------------------------------------
# Supports both V2 (Checkbox) and V3 (Invisible)
RECAPTCHA_ENABLED=true
RECAPTCHA_SCORE_THRESHOLD=0.9

RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=

RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

# Aliases for compatibility
RECAPTCHA_SITE_KEY="${RECAPTCHA_V3_SITE_KEY}"
RECAPTCHA_SECRET_KEY="${RECAPTCHA_V3_SECRET_KEY}"
VITE_RECAPTCHA_SITE_KEY="${RECAPTCHA_SITE_KEY}"
VITE_RECAPTCHA_V2_SITE_KEY="${RECAPTCHA_V2_SITE_KEY}"

# -------------------------------------------
# Google Safe Browsing
# -------------------------------------------
GOOGLE_SAFE_BROWSING_KEY=

# -------------------------------------------
# Twilio (SMS / 2FA)
# -------------------------------------------
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM=
TWILIO_VOICE_FROM=
TWILIO_VOICE_APP_SID=
TWILIO_VOICE_TWIML_URL=
TWILIO_VOICE_STATUS_CALLBACK_URL=

DIALER_ADAPTER=demo
DIALER_HISTORY_LIMIT=15
DIALER_DEMO_CALLER_ID=+10000000000
DIALER_ACD_PIPE_PREPARED=true
DIALER_ACD_PIPE_CONNECTED=false

# -------------------------------------------
# OpenAI (AI Features)
# -------------------------------------------
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT=3

# -------------------------------------------
# GeoIP / Location Services
# -------------------------------------------
MAXMIND_ACCOUNT_ID=
MAXMIND_USER_ID=
MAXMIND_LICENSE_KEY=
IPGEOLOCATION_KEY=
IPDATA_API_KEY=
IPFINDER_API_KEY=

# -------------------------------------------
# AWS S3 (Production File Storage)
# -------------------------------------------
FILESYSTEM_AUTO_CLOUD=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -------------------------------------------
# Cloudflare R2 (S3-Compatible Storage)
# -------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# Laravel Cloud disk JSON config (optional)
LARAVEL_CLOUD_DISK_CONFIG=

# -------------------------------------------
# Media Library (Spatie)
# -------------------------------------------
MEDIA_DISK=public
MEDIA_QUEUE=
QUEUE_CONVERSIONS_BY_DEFAULT=true
QUEUE_CONVERSIONS_AFTER_DB_COMMIT=true
MEDIA_PREFIX=
MEDIA_DOWNLOADER_SSL=true

# -------------------------------------------
# IMAP (Email Client)
# -------------------------------------------
IMAP_DEFAULT_ACCOUNT=default
IMAP_HOST=localhost
IMAP_PORT=993
IMAP_PROTOCOL=imap
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_AUTHENTICATION=

# -------------------------------------------
# Search
# -------------------------------------------
SCOUT_DRIVER=database

# -------------------------------------------
# Chat - Giphy Integration
# -------------------------------------------
GIPHY_API_KEY=

# WebRTC / Video Calls (Cloudflare)
# -------------------------------------------
# 1. TURN Configuration (Required for NAT Traversal)
TURN_KEY_ID=
TURN_KEY_API_TOKEN=
# TURN credential lifetime in seconds (Cloudflare max: 172800 / 48h)
TURN_CREDENTIAL_TTL=14400
# Browsers commonly block port 53 for STUN/TURN; keep this enabled for web clients
TURN_FILTER_BLOCKED_BROWSER_PORTS=true

# 2. SFU Configuration (Required for Group Calls > 6 participants)
# Use Cloudflare Calls "App ID" and "App Secret"
CLOUDFLARE_APP_ID_SFU=
CLOUDFLARE_APP_SECRET_SFU=

# 3. RealtimeKit (PRO Meeting Recording)
# Get these from: dash.realtime.cloudflare.com → API Keys
# - Create an Organization and App first, then copy credentials below.
# Set MEETING_RECORDING_ENABLED=true to enable the recording button (dev toggle).
# Replace with a billing/subscription check when you have real pro users.
CLOUDFLARE_REALTIME_ACCOUNT_ID=
CLOUDFLARE_REALTIME_API_TOKEN=
CLOUDFLARE_REALTIME_APP_ID=
MEETING_RECORDING_ENABLED=true
MEETING_RECORDING_STORE_LOCAL=false
# Set to r2 in production if you want durable cloud retention for recordings.
MEETING_RECORDING_STORAGE_DISK=private
MEETING_MAX_PER_USER=15
MEETING_CHAT_ADAPTER_ENABLED=true
MEETING_CHAT_ADAPTER=meeting

# -------------------------------------------
# Support Chat
# -------------------------------------------
SUPPORT_CHAT_JOBS_ENABLED=true
SUPPORT_CHAT_BROADCAST_MODE=queue_first
SUPPORT_CHAT_JOBS_QUEUE=chats
SUPPORT_ACCESS_ADAPTER=skills
SUPPORT_SKILLS_ENABLED=true
SUPPORT_SKILLS_ALLOW_LEGACY_FALLBACK=false
SUPPORT_SKILLS_ALLOW_UNROUTED_FALLBACK=false
SUPPORT_ROUTING_ENGINE=acd

# -------------------------------------------
# Security / Firewall
# -------------------------------------------
FIREWALL_MIDDLEWARE_RFI_ENABLED=false

# -------------------------------------------
# Media Tooling
# -------------------------------------------
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# -------------------------------------------
# Misc
# -------------------------------------------
DEMO_MODE_SECRET_HASH=

# -------------------------------------------
# Frontend / Vite
# -------------------------------------------
VITE_APP_NAME="${APP_NAME}"
VITE_API_BASE_URL="${APP_URL}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
